# 复制为 .env 后按需修改；本地默认值已经写在 application.yml / docker-compose.yml 中。
# 注意：docker compose 不会自动读取本文件，基础设施默认口令见 deploy/docker-compose.yml。

# ===== 共享鉴权 token =====
# 调度中心与执行器之间的内部接口双向鉴权用（请求头 X-TaskPilot-Token）。
# 两边必须配成同一个值；生产环境必须覆盖掉默认值！
TASKPILOT_AUTH_TOKEN=taskpilot-dev-token

# ===== Scheduler =====
TASKPILOT_MYSQL_URL="jdbc:mysql://localhost:3306/taskpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
TASKPILOT_MYSQL_USERNAME=taskpilot
TASKPILOT_MYSQL_PASSWORD=taskpilot

# ===== Executor =====
TASKPILOT_EXECUTOR_ADDRESS=127.0.0.1:8081
# 调度中心地址，支持逗号分隔多个（一个挂掉还能通过另一个心跳）
TASKPILOT_SCHEDULER_URL=http://127.0.0.1:8080

# ===== RabbitMQ（第 4 周起：结果异步上报 + 死信告警）=====
TASKPILOT_RABBITMQ_HOST=127.0.0.1
TASKPILOT_RABBITMQ_PORT=5672
TASKPILOT_RABBITMQ_USERNAME=taskpilot
TASKPILOT_RABBITMQ_PASSWORD=taskpilot

# ===== 告警 webhook（可选，不配就只记日志）=====
# TASKPILOT_ALERT_WEBHOOK_URL=http://127.0.0.1:9000/alert
