# 复制为 .env 后按本地环境修改；不要提交 .env

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=taskpilot
MYSQL_USER=taskpilot
MYSQL_PASSWORD=taskpilot
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Nacos
NACOS_SERVER_ADDR=localhost:8848

# 应用
TASKPILOT_SCHEDULER_URL=http://127.0.0.1:8080
TASKPILOT_EXECUTOR_ADDRESS=127.0.0.1:8081

# 时区
TZ=Asia/Shanghai
