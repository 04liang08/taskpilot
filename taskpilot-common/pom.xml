<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.taskpilot</groupId>
    <artifactId>taskpilot</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>taskpilot-common</artifactId>
  <name>taskpilot-common</name>
  <description>跨模块 DTO、枚举、异常、工具类；不依赖 Spring Web</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- RabbitMQ 拓扑声明（交换机/队列/绑定）。
         只用 spring-amqp 的抽象模型，不引入客户端与 Spring 容器，
         保持 common 轻量、可被任意模块引用。 -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-amqp</artifactId>
    </dependency>
  </dependencies>
</project>